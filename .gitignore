# =============================================================================
# .gitignore — XApp-RDL-F2 (CA-RDL)
# Regras Permanentes de Exclusão, Higienização e Proteção do Repositório
# =============================================================================

# 1. Snapshots, Arquivos Compactados e Dumps (PERMANENTEMENTE PROIBIDO NO GITHUB)
.snapshots/
snapshots/
*snapshot*
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.gz

# 2. Artigos Científicos, Papers, Fontes LaTeX / Typst e PDFs (PERMANENTEMENTE PROIBIDO NO GITHUB)
paper/
paper_*/
paper_sbrc/
paper_ieee/
*.tex
*.bib
*.sty
*.cls
*.bbl
*.blg
*.aux
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.pdf
*.typ
*Dissertacao*
*dissertacao*

# 3. Diretórios de Agentes e Skills Locais (Permanentemente Proibido)
.agents/
/agents/
!src/agents/
skills/
.system_generated/

# 4. Auditoria Técnica e Relatórios Extensos Internos
auditoria/
*relatorio_extenso*
*.audit.md
docs/relatorio_extenso*
!docs/auditoria/
!docs/auditoria/*

# 5. Notebooks do Google Colab e Análises Locais
notebooks/
*.ipynb
.ipynb_checkpoints/

# 6. Backups, Sincronização Local e Rollbacks
*backup*
!scripts/backup_to_google_drive.*
backups/
*rollback*
*sync*
!docs/compliance/*.md

# 7. Byte-compiled / Python Cache / DLLs / Egg-Info / C++ Builds
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.o
*.obj
*.exe
*.dll
*.egg-info/
*.egg-info
*.egg
build/
dist/

# 8. Ambientes Virtuais
.venv/
venv/
ENV/
env/

# 9. Testes e Cobertura
.pytest_cache/
.coverage
htmlcov/

# 10. Logs e Bancos de Dados Locais
*.log
!experiments/runs/certified_closed_loop_chain/*.log
*.sqlite3
wheels/

# 11. Sistema Operacional e IDEs
.DS_Store
.vscode/
.idea/
Thumbs.db

# 12. Scripts PowerShell locais de automação IDE
*.ps1

# =============================================================================
# Regras Estritas de Exclusão: Scripts Não-Essenciais (PROIBIDO NO GITHUB)
# =============================================================================

