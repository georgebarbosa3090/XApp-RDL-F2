# =============================================================================
# .gitignore — XApp-RDL-F2 (Context-Aware RDL / Safe-MARL)
# Regras Permanentes de Exclusão e Higienização de Repositório
# =============================================================================

# 1. Byte-compiled / Python Cache / Shared Objects / C-Extensions
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg-info/
build/
dist/

# 2. Ambientes Virtuais e Gerenciadores de Pacote
.venv/
venv/
ENV/
env/

# 3. Testes, Cobertura e Caches de IDE
.pytest_cache/
.coverage
htmlcov/
.DS_Store
.vscode/
.idea/
Thumbs.db

# 4. Logs e Arquivos Temporários de Execução
*.log
*.sqlite3
.snapshots/
.system_generated/
.agents/

# 5. Caches de Notebooks
.ipynb_checkpoints/
